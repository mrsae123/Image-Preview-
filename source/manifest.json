{
  "specVersion": 2,
  "id": "com.emon.image-viewer",
  "name": {
    "$t": "plugin.name"
  },
  "version": "2.21.1",
  "entry": "entry.js",
  "author": "Emon",
  "description": {
    "$t": "plugin.description"
  },
  "releaseNotes": {
    "$t": "releaseNotes.2_21_1"
  },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json",
      "bn": "locales/bn.json"
    }
  },
  "permissions": [
    "file",
    "network",
    "variable",
    "input"
  ],
  "contributes": {
    "inputActions": [
      {
        "id": "extract-images",
        "label": {
          "$t": "actions.extractImages"
        }
      }
    ],
    "sidebar": [
      {
        "id": "reset-fab-position",
        "label": {
          "$t": "actions.resetFabPosition"
        }
      },
      {
        "id": "open-recycle-bin",
        "label": {
          "$t": "actions.openRecycleBin"
        }
      }
    ],
    "htmlFragments": [
      {
        "id": "emon-image-viewer",
        "src": "ui/panel.html",
        "mount": "/chat/body/end"
      }
    ],
    "settings": {
      "schema": [
        {
          "type": "info",
          "text": {
            "$t": "settings.info"
          },
          "icon": "info"
        },
        {
          "key": "enabled",
          "type": "switch",
          "label": {
            "$t": "settings.enabled"
          },
          "default": true
        },
        {
          "key": "buttonSize",
          "type": "slider",
          "label": {
            "$t": "settings.buttonSize"
          },
          "min": 28,
          "max": 64,
          "step": 2,
          "default": 54
        },
        {
          "key": "buttonOpacity",
          "type": "slider",
          "label": {
            "$t": "settings.buttonOpacity"
          },
          "min": 0,
          "max": 1,
          "step": 0.05,
          "default": 1
        },
        {
          "key": "stealthMode",
          "type": "switch",
          "label": {
            "$t": "settings.stealthMode"
          },
          "default": false
        },
        {
          "key": "defaultImageSize",
          "type": "slider",
          "label": {
            "$t": "settings.defaultImageSize"
          },
          "min": 120,
          "max": 420,
          "step": 10,
          "default": 220
        },
        {
          "key": "defaultOpacity",
          "type": "slider",
          "label": {
            "$t": "settings.defaultOpacity"
          },
          "min": 0.35,
          "max": 1,
          "step": 0.05,
          "default": 0.95
        },
        {
          "key": "rememberPins",
          "type": "switch",
          "label": {
            "$t": "settings.rememberPins"
          },
          "default": true
        },
        {
          "type": "divider"
        },
        {
          "type": "info",
          "text": {
            "$t": "settings.recycleInfo"
          },
          "icon": "info"
        },
        {
          "key": "recycleBinRetention",
          "type": "select",
          "label": {
            "$t": "settings.recycleBinRetention"
          },
          "default": "30",
          "options": [
            {
              "value": "7",
              "label": {
                "$t": "settings.retention7"
              }
            },
            {
              "value": "30",
              "label": {
                "$t": "settings.retention30"
              }
            }
          ]
        }
      ]
    }
  },
  "cover": "icon.png"
}